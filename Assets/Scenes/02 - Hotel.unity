MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1943291633}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b4f4275c71431934e9b578f46becc532, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  questions:
  - question: "Hola, disculpa, \xBFtal vez sabes en qu\xE9 ciudad de Ecuador puedo
      probar uno de los caf\xE9s m\xE1s reconocidos?"
    optionA: Loja
    optionB: Salinas
    optionC: Latacunga
    correctIndex: 0
    correctFeedback: "\xA1Correcto! Loja es muy reconocida por su caf\xE9 de especialidad.\n"
    wrongFeedback: "No exactamente. La respuesta correcta es Loja, una ciudad reconocida
      por su caf\xE9."
  - question: "Hola, \xBFsabes d\xF3nde puedo visitar un mercado famoso por sus artesan\xEDas
      y textiles ind\xEDgenas?"
    optionA: Ambato
    optionB: Otavalo
    optionC: Cuenca
    correctIndex: 1
    correctFeedback: "\xA1Correcto! Otavalo es famoso por su mercado artesanal y
      sus textiles."
    wrongFeedback: "No exactamente. La respuesta correcta es Otavalo, conocido por
      su mercado ind\xEDgena y artesanal."
  - question: "Disculpa, \xBFen qu\xE9 lugar puedo ver una laguna dentro de un cr\xE1ter
      volc\xE1nico?"
    optionA: Guayaquil
    optionB: Cuenca
    optionC: Quilotoa
    correctIndex: 2
    correctFeedback: "\xA1Correcto! Quilotoa es famoso por su laguna ubicada en un
      cr\xE1ter volc\xE1nico."
    wrongFeedback: "La respuesta correcta es Quilotoa, una laguna formada dentro
      de un cr\xE1ter."
  - question: "Hola, \xBFd\xF3nde puedo hacer actividades de aventura, ver cascadas
      y visitar aguas termales?"
    optionA: "Ba\xF1os de Agua Santa"
    optionB: Quito
    optionC: Salinas
    correctIndex: 0
    correctFeedback: "\xA1Correcto! Ba\xF1os de Agua Santa es famoso por sus cascadas,
      aventura y aguas termales."
    wrongFeedback: "La respuesta correcta es Ba\xF1os de Agua Santa, un destino muy
      visitado por turistas."
  - question: "Hola, \xBFsabes d\xF3nde puedo ir a ver las tortugas gigantes y animales
      \xFAnicos en el mundo?"
    optionA: Guayaquil
    optionB: "Gal\xE1pagos"
    optionC: Riobamba
    correctIndex: 1
    correctFeedback: "\xA1Correcto! En Gal\xE1pagos se pueden observar especies \xFAnicas,
      como las tortugas gigantes."
    wrongFeedback: "La respuesta correcta es Gal\xE1pagos."
  - question: "Disculpa, \xBFd\xF3nde puedo visitar uno de los volcanes m\xE1s famosos
      de Ecuador?"
    optionA: Zaruma
    optionB: "Monta\xF1ita"
    optionC: Cotopaxi
    correctIndex: 2
    correctFeedback: "\xA1Correcto! El Cotopaxi es uno de los volcanes m\xE1s conocidos
      del Ecuador."
    wrongFeedback: La respuesta correcta es Cotopaxi.
  - question: "Hola, \xBFtal vez sabes d\xF3nde puedo ir si quiero surfear y disfrutar
      de un ambiente playero?"
    optionA: "Monta\xF1ita"
    optionB: Ambato
    optionC: Latacunga
    correctIndex: 0
    correctFeedback: "\xA1Correcto! Monta\xF1ita es conocida por el surf y su ambiente
      de playa."
    wrongFeedback: "La respuesta correcta es Monta\xF1ita."
  - question: "Hola, \xBFsabes d\xF3nde puedo ver ballenas jorobadas durante cierta
      \xE9poca del a\xF1o?"
    optionA: Ibarra
    optionB: Ambato
    optionC: Salinas
    correctIndex: 2
    correctFeedback: "\xA1Correcto! En la zona costera, como Salinas, se pueden hacer
      actividades relacionadas con avistamiento de ballenas en temporada."
    wrongFeedback: La respuesta correcta es Salinas.
  - question: "Disculpa, \xBFd\xF3nde puedo visitar un lugar famoso por estar en
      la l\xEDnea ecuatorial?"
    optionA: Mitad del Mundo
    optionB: "Ba\xF1os"
    optionC: Cuenca
    correctIndex: 0
    correctFeedback: "\xA1Correcto! La Mitad del Mundo es uno de los lugares m\xE1s
      visitados en Quito."
    wrongFeedback: La respuesta correcta es la Mitad del Mundo.
